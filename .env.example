# Required. Create one at https://torbox.app/settings (API key).
TORBOX_API_KEY=

# Required in practice. The addon URL is https://your-host/<secret>.
# Generate one with: openssl rand -hex 24
# Use URL-safe characters only (letters, digits, . _ ~ -); avoid spaces and /.
# Leave empty to generate one once and save it in the data volume.
ADDON_SECRET=

# Optional. Set this when a reverse proxy does not send X-Forwarded-Proto/Host.
# Example: https://music.example.com
PUBLIC_BASE_URL=

# How often to re-read the TorBox account. Accepts 15m, 1h, 900s.
REFRESH_INTERVAL=15m

# Which audio files to index. The default is the lossless set plus m4a.
AUDIO_EXTENSIONS=flac,wav,aiff,aif,alac,m4a

# Include each TorBox collection. Turn off the ones you do not use.
INCLUDE_TORRENTS=true
INCLUDE_USENET=true
INCLUDE_WEB=true

# Stream through this addon (recommended: keeps TorBox links private and
# supports seeking) or hand BitChord the CDN URL directly.
PROXY_AUDIO=true

# Optional tuning.
# STARTUP_REFRESH=true
# PAGE_SIZE=1000
# MAX_PAGES=50
# REQUEST_TIMEOUT=30
